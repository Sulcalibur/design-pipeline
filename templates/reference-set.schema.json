{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Reference set",
  "description": "Structured extraction of looked-at design references. One record per reference. Prose lives in 01-references.md; this file is for comparison, querying and diffing across projects.",
  "type": "object",
  "required": ["project", "capturedAt", "references"],
  "properties": {
    "project": { "type": "string" },
    "capturedAt": { "type": "string", "format": "date" },
    "queryLog": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source", "query"],
        "properties": {
          "source": { "enum": ["eagle", "url", "mobbin", "other"] },
          "query": { "type": "string" },
          "results": { "type": "integer" },
          "used": { "type": "integer" }
        }
      }
    },
    "references": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "source", "category", "devices", "avoid"],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "source": {
            "type": "object",
            "required": ["kind"],
            "properties": {
              "kind": { "enum": ["eagle", "url", "mobbin", "file"] },
              "url": { "type": "string" },
              "eagleId": { "type": "string" },
              "path": { "type": "string" }
            }
          },
          "category": {
            "enum": ["personal-site", "editorial", "product", "print", "illustration", "film", "packaging", "other"]
          },
          "distance": {
            "type": "string",
            "description": "Why this reference is outside the project's own category, if it is."
          },
          "palette": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["role", "hex"],
              "properties": {
                "role": { "enum": ["surface", "surface-alt", "ink", "muted", "accent", "accent-2", "signal"] },
                "hex": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" }
              }
            }
          },
          "typography": {
            "type": "object",
            "properties": {
              "display": { "type": "string" },
              "body": { "type": "string" },
              "scale": { "type": "array", "items": { "type": "string" } },
              "measure": { "type": "string" }
            }
          },
          "structure": {
            "type": "array",
            "description": "Section order, in the page's own words.",
            "items": { "type": "string" }
          },
          "devices": {
            "type": "array",
            "description": "Transferable mechanics.",
            "items": { "type": "string" }
          },
          "avoid": {
            "type": "array",
            "description": "Surface details that belong to the source brand and must not be copied.",
            "items": { "type": "string" }
          },
          "notes": { "type": "string" }
        }
      }
    }
  }
}
